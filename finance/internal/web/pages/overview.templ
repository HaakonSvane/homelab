package pages

import (
	"fmt"
	"github.com/HaakonSvane/homelab/finance/internal/month"
	"github.com/HaakonSvane/homelab/finance/internal/web/components"
	"strings"
)

templ Overview(v OverviewView) {
	@components.Page("Oversikt", components.TabOverview) {
		<h1>{ v.Greeting }</h1>
		@components.MonthNavigation(v.Nav)
		if v.NoExpenses {
			<p class="notice">Ingen utgifter registrert ennå. <a href="/utgifter">Legg inn de faste utgiftene</a>, så ser dere hva hver skal overføre.</p>
		}
		if len(v.MissingIncome) > 0 {
			<p class="notice">Mangler inntekt for { strings.Join(v.MissingIncome, " og ") }. <a href="/inntekt">Registrer inntekt</a>, så ser dere hva som blir igjen.</p>
		}
		if v.IsCurrent && len(v.Free) > 0 {
			<section>
				<h2>Til fri bruk</h2>
				for _, f := range v.Free {
					<div class="free">
						<div class="row">
							<span>{ f.Name }</span>
							if f.HasPayday {
								<span class="num">{ components.Kr(f.ShouldHave) }</span>
							}
						</div>
						if f.HasPayday {
							<progress max={ fmt.Sprint(f.Days) } value={ fmt.Sprint(f.Elapsed) } aria-label={ "Dager siden lønning for " + f.Name }></progress>
							<p class="muted small">
								Bør være igjen nå med jevnt forbruk. Lønning { f.NextPayday }, om { f.DaysLeft } ·
								<span class="num">{ components.Kr(f.NormalPerDay) }</span> per dag.
							</p>
							if f.Note != "" {
								<p class="muted small">{ f.Note }</p>
							}
						} else {
							<p class="muted small">Legg inn lønningsdag under <a href="/inntekt">Inntekt</a>, så vises det her.</p>
						}
					</div>
				}
			</section>
			@BuySection(v.Buy)
		}
		<section>
			<h2>Til felleskontoen</h2>
			<table class="ledger">
				<tbody>
					for _, u := range v.Users {
						<tr>
							<th scope="row">{ u.Name }</th>
							<td class="num">{ components.Amount(u.ToFelleskonto) }</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr>
						<th scope="row">Felleskontoen får</th>
						<td class="num total">{ components.Amount(v.Felleskonto) }</td>
					</tr>
				</tfoot>
			</table>
			for _, re := range v.Reimbursements {
				<p class="callout">{ re.From } skylder { re.To } <span class="num">{ components.Kr(re.Amount) }</span> denne måneden.</p>
			}
			for _, u := range v.Users {
				if u.PaidDirect > 0 {
					<p class="muted small">{ u.Name } betaler i tillegg <span class="num">{ components.Kr(u.PaidDirect) }</span> av felles regninger direkte (månedlig snitt).</p>
				}
			}
			<p class="muted small">Beløpene er like hver måned: uregelmessige regninger er jevnet ut over året, så felleskontoen bygger opp en buffer.</p>
		</section>
		<section>
			<h2>Igjen etter faste utgifter</h2>
			<table class="ledger">
				<tbody>
					for _, u := range v.Users {
						<tr>
							<th scope="row">
								{ u.Name }
								<div class="muted small">
									Inntekt { components.Amount(u.Income) } − felles { components.Amount(u.Obligation) } − privat { components.Amount(u.Private) }
								</div>
							</th>
							<td class="num">{ components.Amount(u.Leftover) }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
		<section>
			<h2>Forfaller i { month.Name(v.Nav.Month.Month()) }</h2>
			if len(v.Due) == 0 {
				<p class="muted">Ingen regninger forfaller denne måneden.</p>
			} else {
				<table class="ledger">
					<tbody>
						for _, d := range v.Due {
							<tr>
								<td class="icon-cell">
									@components.Icon(d.Icon)
								</td>
								<th scope="row">
									{ d.Name }
									<div class="muted small">{ d.Payer }</div>
								</th>
								<td class="num">{ components.Amount(d.Amount) }</td>
							</tr>
						}
					</tbody>
				</table>
				<p class="muted small">
					Fra felleskontoen går <span class="num">{ components.Kr(v.DueFromFelleskonto) }</span> ut og
					<span class="num">{ components.Kr(v.Felleskonto) }</span> inn:
					if v.BufferChange >= 0 {
						bufferen øker med <span class="num">{ components.Kr(v.BufferChange) }</span>.
					} else {
						bufferen brukes med <span class="num">{ components.Kr(-v.BufferChange) }</span>.
					}
				</p>
			}
		</section>
		if len(v.Upcoming) > 0 {
			<section>
				<h2>Kommende store regninger</h2>
				<table class="ledger">
					<tbody>
						for _, u := range v.Upcoming {
							<tr>
								<td class="icon-cell">
									@components.Icon(u.Icon)
								</td>
								<th scope="row">
									{ u.Name }
									<div class="muted small">{ u.When } · { u.Payer }</div>
								</th>
								<td class="num">{ components.Amount(u.Amount) }</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
		@BufferSection(v.Buffer)
	}
}

// BuySection is "Kan jeg kjøpe?". With htmx only this section is swapped.
templ BuySection(b BuyForm) {
	<section id="kan-jeg-kjope">
		<h2>Kan jeg kjøpe?</h2>
		if !b.HasPayday {
			<p class="muted small">Legg inn lønningsdagen din under <a href="/inntekt">Inntekt</a>, så kan du sjekke kjøp mot budsjettet.</p>
		} else {
			<form class="calc" method="post" action="/kan-jeg-kjope" hx-post="/kan-jeg-kjope" hx-target="#kan-jeg-kjope" hx-select="#kan-jeg-kjope" hx-swap="outerHTML transition:false" novalidate>
				<div class="field">
					<label for="price">Pris (kr)</label>
					<input id="price" name="price" value={ b.Price } inputmode="decimal" autocomplete="off" placeholder="0,00" autofocus?={ b.Errors["price"] != "" }/>
					@fieldError(b.Errors["price"])
				</div>
				<div class="field">
					<label for="balance">Saldo nå (kr)</label>
					<input id="balance" name="balance" value={ b.Balance } inputmode="decimal" autocomplete="off" placeholder="0,00" autofocus?={ b.Errors["price"] == "" && b.Errors["balance"] != "" }/>
					@fieldError(b.Errors["balance"])
				</div>
				<p class="muted small hint">Saldoen på brukskontoen etter at faste trekk og overføringer er gått. Ingenting du skriver her lagres.</p>
				<button type="submit" class="primary">Sjekk</button>
			</form>
			if b.Result != nil {
				<div class={ templ.Classes("verdict", b.Result.Kind) } role="status">
					<p class="verdict-head">
						@components.Icon(b.Result.Icon)
						{ b.Result.Headline }
					</p>
					for _, line := range b.Result.Lines {
						<p class="small">{ line }</p>
					}
				</div>
			}
		}
	</section>
}

// BufferSection is how much the felleskonto should hold, with an optional balance check.
templ BufferSection(b BufferView) {
	<section id="buffer">
		<h2>Buffer på felleskontoen</h2>
		if b.Required == 0 {
			<p>Overføringene dekker alle regningene de neste tolv månedene, så det trengs ingen ekstra buffer.</p>
		} else {
			<p>
				Ved inngangen til { b.From } bør felleskontoen ha minst <span class="num">{ components.Kr(b.Required) }</span>
				før månedens overføringer kommer inn.
			</p>
			<p class="muted small">{ b.LowNote }</p>
		}
		if b.CanCheck {
			<form class="inline-form" method="post" action="/felleskonto/saldo" hx-post="/felleskonto/saldo" hx-target="#buffer" hx-select="#buffer" hx-swap="outerHTML transition:false" novalidate>
				<input name="balance" value={ b.Balance } inputmode="decimal" autocomplete="off" placeholder="Saldo nå" aria-label="Saldo på felleskontoen nå" autofocus?={ b.Errors["balance"] != "" }/>
				<button type="submit">Sjekk saldo</button>
			</form>
			@fieldError(b.Errors["balance"])
			if b.Result != "" {
				<p class={ templ.KV("error", b.Short) } role="status">{ b.Result }</p>
			}
		}
	</section>
}
