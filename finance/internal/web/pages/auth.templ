package pages

import "github.com/HaakonSvane/homelab/finance/internal/web/components"

templ intro(subtitle string) {
	<div class="intro">
		<span class="wordmark">Finans</span>
		if subtitle != "" {
			<p class="muted">{ subtitle }</p>
		}
	</div>
}

templ Login() {
	@components.Page("Logg inn", components.TabNone) {
		@intro("Felleskontoen vår")
		<button type="button" class="primary wide" data-passkey="login">Logg inn med passkey</button>
		<p id="passkey-error" class="error" role="alert" hidden></p>
		<noscript><p class="error">Innlogging med passkey krever JavaScript.</p></noscript>
		<p class="muted small help">
			Ny enhet? Logg inn på en enhet du allerede bruker og legg til en passkey under Innstillinger,
			eller be om en registreringslenke.
		</p>
		@components.PasskeyScript()
	}
}

templ Enroll(displayName string, token string) {
	@components.Page("Registrer passkey", components.TabNone) {
		@intro("Registrer passkey")
		<h1>Hei, { displayName }!</h1>
		<p>
			Med en passkey logger du inn med Face ID eller Touch ID. Ligger den i iCloud-nøkkelringen,
			blir den med til de andre Apple-enhetene dine.
		</p>
		<p class="muted small">Lenken kan bare brukes én gang og utløper etter 30 minutter.</p>
		<button type="button" class="primary wide" data-passkey="register" data-token={ token }>Registrer passkey</button>
		<p id="passkey-error" class="error" role="alert" hidden></p>
		<noscript><p class="error">Registrering av passkey krever JavaScript.</p></noscript>
		@components.PasskeyScript()
	}
}

templ EnrollInvalid() {
	@components.Page("Ugyldig lenke", components.TabNone) {
		@intro("Registrer passkey")
		<h1>Lenken virker ikke</h1>
		<p>Registreringslenken er ugyldig, allerede brukt eller utløpt.</p>
		<p class="muted">Be om en ny lenke, eller logg inn på en enhet du allerede bruker og legg til en passkey under Innstillinger.</p>
		<p><a class="button" href="/logg-inn">Til innlogging</a></p>
	}
}

templ Error(title string, message string) {
	@components.Page(title, components.TabNone) {
		@intro("")
		<h1>{ title }</h1>
		<p>{ message }</p>
		<p><a class="button" href="/">Til forsiden</a></p>
	}
}
