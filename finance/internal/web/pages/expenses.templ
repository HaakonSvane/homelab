package pages

import (
	"fmt"
	"github.com/HaakonSvane/homelab/finance/internal/web/components"
)

templ Expenses(v ExpensesView) {
	@components.Page("Utgifter", components.TabExpenses) {
		<div class="page-head">
			<h1>Utgifter</h1>
			@sheetButton("/utgifter/ny", "#expense-form", "primary with-icon") {
				@components.Icon("plus")
				Ny utgift
			}
		</div>
		@components.MonthNavigation(v.Nav)
		if v.Empty {
			<p class="muted">Ingen utgifter ennå. Legg inn de faste utgiftene deres, felles og private.</p>
		}
		for _, g := range v.Groups {
			<details class="group" open?={ g.Open }>
				<summary>
					<h2>{ g.Title }</h2>
					<span class="num muted small">{ components.Amount(g.Monthly) } / mnd</span>
					@components.Icon("chevron-down")
				</summary>
				@expenseTable(g.Rows, false)
			</details>
		}
		if len(v.Inactive) > 0 {
			<details class="group">
				<summary>
					<h2>Avsluttede og kommende</h2>
					<span class="muted small">{ fmt.Sprint(len(v.Inactive)) }</span>
					@components.Icon("chevron-down")
				</summary>
				@expenseTable(v.Inactive, true)
			</details>
		}
		if !v.Empty {
			<p class="muted small footnote">Beløpene er per måned. En regning som kommer to ganger i året, teller med en sjettedel hver måned.</p>
		}
	}
}

templ expenseTable(rows []ExpenseRow, inactive bool) {
	<table class="ledger">
		<tbody>
			for _, row := range rows {
				<tr>
					<td class="icon-cell">
						@components.Icon(row.Icon)
					</td>
					<th scope="row">
						@sheetButton(fmt.Sprintf("/utgifter/%d/endre", row.ID), "#expense-form", "linklike") {
							{ row.Name }
						}
						<div class="muted small">
							if inactive {
								{ row.Status } ·
							}
							{ row.Details }
						</div>
					</th>
					<td class="num">{ components.Amount(row.Monthly) }</td>
				</tr>
			}
		</tbody>
	</table>
}

// sheetButton opens the bottom sheet (popover, no script) and has htmx load the form
// at href into it.
templ sheetButton(href string, selector string, class string) {
	<button type="button" class={ class } popovertarget="sheet" hx-get={ href } hx-target="#sheet-body" hx-select={ selector } hx-swap="innerHTML transition:false" hx-indicator="#sheet">
		{ children... }
	</button>
}

templ freqOption(f ExpenseForm, value string, label string) {
	<label class="seg-option">
		<input type="radio" name="freq" value={ value } checked?={ f.Freq == value } autofocus?={ f.Focus == "due" && value == "monthly" }/>
		<span>{ label }</span>
	</label>
}

func deleteConfirmText(name string) string {
	return "Slette «" + name + "» for godt?\n\nAll historikk for utgiften slettes også, og tidligere måneder regnes om uten den. Dette kan ikke angres."
}

func versionCount(n int) string {
	if n == 1 {
		return "1 versjon"
	}
	return fmt.Sprintf("%d versjoner", n)
}

// ConfirmDeleteExpense is the confirmation step when JavaScript (and so the
// browser's confirm dialog) isn't available.
templ ConfirmDeleteExpense(c DeleteConfirm) {
	@components.Page("Slett utgift", components.TabExpenses) {
		<h1>Slette «{ c.Name }»?</h1>
		<p>All historikk for utgiften slettes også ({ versionCount(c.Versions) }), og tidligere måneder regnes om uten den. Dette kan ikke angres.</p>
		<p class="muted small">Skal den bare stoppe fra en måned, avslutt den i stedet.</p>
		<form method="post" action={ templ.SafeURL(c.Action) }>
			<input type="hidden" name="bekreft" value="ja"/>
			<div class="actions">
				<button type="submit" class="danger with-icon">
					@components.Icon("trash")
					Slett for godt
				</button>
				<a class="button quiet" href="/utgifter">Avbryt</a>
			</div>
		</form>
	}
}

templ fieldError(msg string) {
	if msg != "" {
		<p class="error small" role="alert">{ msg }</p>
	}
}

templ ExpenseFormPage(f ExpenseForm) {
	@components.Page(expenseTitle(f), components.TabExpenses) {
		@ExpenseFormBody(f)
	}
}

func expenseTitle(f ExpenseForm) string {
	if f.ID == 0 {
		return "Ny utgift"
	}
	return "Endre utgift"
}

templ ExpenseFormBody(f ExpenseForm) {
	<div id="expense-form" class="form-body">
		<h2>
			if f.ID == 0 {
				Ny utgift
			} else {
				{ f.Name }
			}
		</h2>
		<form method="post" action={ templ.SafeURL(f.Action) } hx-post={ f.Action } hx-target="#expense-form" hx-select="#expense-form" hx-swap="outerHTML transition:false" novalidate>
			@fieldError(f.Errors["form"])
			<div class="field">
				<label for="name">Navn</label>
				<input id="name" name="name" value={ f.Name } maxlength="100" autocomplete="off" autofocus?={ f.Focus == "name" }/>
				@fieldError(f.Errors["name"])
			</div>
			<div class="field">
				<label for="category">Kategori</label>
				<input id="category" name="category" value={ f.Category } list="categories" maxlength="50" autocomplete="off" placeholder="For eksempel Bolig" autofocus?={ f.Focus == "category" }/>
				<datalist id="categories">
					for _, c := range f.Categories {
						<option value={ c }></option>
					}
				</datalist>
				@fieldError(f.Errors["category"])
			</div>
			if f.KindFixed {
				<p class="muted small">{ f.KindLabel }. Hvem utgiften gjelder, kan ikke endres; avslutt den og legg inn en ny i stedet.</p>
			} else {
				<fieldset class="field">
					<legend>Type</legend>
					<div class="seg">
						<label class="seg-option">
							<input type="radio" name="kind" value="shared" checked?={ f.Kind == "shared" } autofocus?={ f.Focus == "kind" }/>
							<span>Felles</span>
						</label>
						<label class="seg-option">
							<input type="radio" name="kind" value="private" checked?={ f.Kind == "private" }/>
							<span>Privat</span>
						</label>
					</div>
					@fieldError(f.Errors["kind"])
				</fieldset>
				<div class="field private-only">
					<label for="owner">Tilhører</label>
					<select id="owner" name="owner" autofocus?={ f.Focus == "owner" }>
						for _, o := range f.Owners {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
					@fieldError(f.Errors["owner"])
				</div>
			}
			<div class="field">
				<label for="amount">Beløp per gang (kr)</label>
				<input id="amount" name="amount" value={ f.Amount } inputmode="decimal" autocomplete="off" placeholder="0,00" autofocus?={ f.Focus == "amount" }/>
				@fieldError(f.Errors["amount"])
			</div>
			<fieldset class="field freq">
				<legend>Forfaller</legend>
				<div class="seg">
					@freqOption(f, "monthly", "Hver måned")
					@freqOption(f, "semiannual", "Halvårlig")
					@freqOption(f, "yearly", "Årlig")
					@freqOption(f, "eleven", "11 mnd (ikke juli)")
				</div>
				<div class="freq-detail freq-semiannual">
					<label for="semi_anchor">Hvilke måneder?</label>
					<select id="semi_anchor" name="semi_anchor">
						for _, o := range f.SemiMonths {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</div>
				<div class="freq-detail freq-yearly">
					<label for="year_anchor">Hvilken måned?</label>
					<select id="year_anchor" name="year_anchor">
						for _, o := range f.YearMonths {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</div>
				<label class="disclosure">
					<input type="radio" name="freq" value="custom" checked?={ f.Freq == "custom" }/>
					Egendefinert
					@components.Icon("chevron-down")
				</label>
				<div class="month-grid">
					for _, m := range f.Months {
						<label><input type="checkbox" name="month" value={ fmt.Sprint(m.Value) } checked?={ m.Checked }/> { m.Label }</label>
					}
				</div>
				@fieldError(f.Errors["due"])
			</fieldset>
			<div class="field">
				<label for="due_day">Trekkes den</label>
				<select id="due_day" name="due_day">
					for _, o := range f.DueDays {
						<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
					}
				</select>
				<p class="muted small">Brukes når bufferen på felleskontoen regnes ut.</p>
			</div>
			if !f.KindFixed || f.Kind == "shared" {
				<div class="shared-only">
					<div class="field">
						<label for="payer">Betales av</label>
						<select id="payer" name="payer" autofocus?={ f.Focus == "payer" }>
							for _, o := range f.Payers {
								<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
							}
						</select>
						@fieldError(f.Errors["payer"])
					</div>
				</div>
			}
			<div class="field">
				<label for="valid_from">
					if f.ID == 0 {
						Gjelder fra
					} else {
						Fra hvilken måned?
					}
				</label>
				<select id="valid_from" name="valid_from" autofocus?={ f.Focus == "valid_from" }>
					for _, o := range f.ValidFrom {
						<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
					}
				</select>
				if f.ID != 0 {
					<p class="muted small">Tidligere måneder beholder de gamle beløpene. Navn og kategori endres for hele historikken.</p>
				}
				@fieldError(f.Errors["valid_from"])
			</div>
			<div class="actions">
				<button type="submit" class="primary">Lagre</button>
				<a class="button quiet" href="/utgifter">Avbryt</a>
			</div>
		</form>
		if f.ID != 0 {
			<div class="form-extra">
				<h3>Avslutt</h3>
				if f.Ended != "" {
					<p>Avsluttet etter { f.Ended }.</p>
					<form method="post" action={ templ.SafeURL(f.Action + "/avslutt") }>
						<input type="hidden" name="action" value="resume"/>
						<button type="submit">Gjenoppta</button>
					</form>
				} else {
					<label for="end">Siste måned</label>
					<form class="inline-form" method="post" action={ templ.SafeURL(f.Action + "/avslutt") }>
						<select id="end" name="end">
							for _, o := range f.EndMonths {
								<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
							}
						</select>
						<button type="submit">Avslutt</button>
					</form>
				}
				@fieldError(f.Errors["end"])
				<h3 class="delete-head">Slett</h3>
				<p class="muted small">
					Sletter utgiften og hele historikken, og tidligere måneder regnes om uten den. Skal den bare stoppe
					fra en måned, bruk Avslutt over.
				</p>
				<form method="post" action={ templ.SafeURL(f.Action + "/slett") } hx-post={ f.Action + "/slett" } hx-confirm={ deleteConfirmText(f.Name) } hx-vals={ `{"bekreft":"ja"}` }>
					<button type="submit" class="danger with-icon">
						@components.Icon("trash")
						Slett utgift
					</button>
				</form>
				if len(f.History) > 0 {
					<details>
						<summary>Historikk</summary>
						<ul class="history">
							for _, h := range f.History {
								<li class="small">{ h }</li>
							}
						</ul>
					</details>
				}
			</div>
		}
	</div>
}
