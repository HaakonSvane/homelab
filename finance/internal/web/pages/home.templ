package pages

import (
	"github.com/HaakonSvane/homelab/finance/internal/store"
	"github.com/HaakonSvane/homelab/finance/internal/web/components"
)

// Home is a placeholder until the overview page is built.
templ Home(u store.User) {
	@components.Page("Oversikt", components.TabOverview) {
		<h1>Hei, { u.DisplayName }!</h1>
		<p class="muted">Du er logget inn. Oversikten over månedens overføringer kommer snart.</p>
	}
}

templ ComingSoon(title string, tab components.Tab) {
	@components.Page(title, tab) {
		<h1>{ title }</h1>
		<p class="muted">Denne siden kommer snart.</p>
	}
}
