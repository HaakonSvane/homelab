package pages

import (
	"fmt"
	"github.com/HaakonSvane/homelab/finance/internal/store"
	"github.com/HaakonSvane/homelab/finance/internal/web/components"
)

// SettingsError is a validation error shown under one passkey's rename form.
type SettingsError struct {
	PasskeyID int64
	Message   string
}

templ Settings(u store.User, passkeys []store.Passkey, formErr SettingsError) {
	@components.Page("Innstillinger", components.TabSettings) {
		<h1>Innstillinger</h1>
		<section>
			<h2>Passkeys</h2>
			<p class="muted small">
				Du logger inn med Face ID eller Touch ID. Passkeys i iCloud-nøkkelringen følger med til
				de andre Apple-enhetene dine.
			</p>
			if len(passkeys) == 0 {
				<p class="muted">Ingen passkeys registrert.</p>
			}
			<ul class="rows">
				for _, p := range passkeys {
					<li>
						<div>
							if p.Label == "" {
								Uten navn
							} else {
								{ p.Label }
							}
						</div>
						<div class="muted small">
							Lagt til { components.Date(p.CreatedAt) } ·
							if p.LastUsedAt.IsZero() {
								ikke brukt ennå
							} else {
								sist brukt { components.DateTime(p.LastUsedAt) }
							}
						</div>
						<details open?={ formErr.PasskeyID == p.ID }>
							<summary>Gi nytt navn</summary>
							<form class="inline-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/innstillinger/passkeys/%d/navn", p.ID)) }>
								<input name="label" value={ p.Label } maxlength="60" aria-label="Nytt navn på passkey" autocomplete="off"/>
								<button type="submit">Lagre</button>
							</form>
							if formErr.PasskeyID == p.ID && formErr.Message != "" {
								<p class="error small" role="alert">{ formErr.Message }</p>
							}
						</details>
					</li>
				}
			</ul>
			<button type="button" data-passkey="register">Legg til passkey på denne enheten</button>
			<p id="passkey-error" class="error" role="alert" hidden></p>
		</section>
		<section>
			<h2>Konto</h2>
			<p>Logget inn som { u.DisplayName }.</p>
			<form method="post" action="/logg-ut">
				<button type="submit">Logg ut</button>
			</form>
		</section>
		@components.PasskeyScript()
	}
}
