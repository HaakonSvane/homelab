package components

import assets "github.com/HaakonSvane/homelab/finance/web"

// Page is the HTML document around every page.
templ Page(title string, tab Tab) {
	<!DOCTYPE html>
	<html lang="nb">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<meta name="apple-mobile-web-app-title" content="Finans"/>
			<title>{ title } · Finans</title>
			<link rel="stylesheet" href={ assets.URL("app.css") }/>
			<script src={ assets.URL("htmx.min.js") } defer></script>
		</head>
		<body>
			if tab == TabNone {
				<main class="page bare">
					{ children... }
				</main>
			} else {
				<div class="page">
					@masthead(tab)
					<main>
						{ children... }
					</main>
				</div>
			}
		</body>
	</html>
}

// PasskeyScript loads the passkey glue; include it on pages with data-passkey buttons.
templ PasskeyScript() {
	<script src={ assets.URL("passkey.js") } defer></script>
}

templ masthead(active Tab) {
	<header class="masthead">
		<a class="wordmark" href="/">Finans</a>
		<nav aria-label="Hovedmeny">
			@navLink("/", "Oversikt", active == TabOverview)
			@navLink("/utgifter", "Utgifter", active == TabExpenses)
			@navLink("/inntekt", "Inntekt", active == TabIncome)
			@navLink("/innstillinger", "Innstillinger", active == TabSettings)
		</nav>
	</header>
}

templ navLink(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		if active {
			aria-current="page"
		}
	>{ label }</a>
}
