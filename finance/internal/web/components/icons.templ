package components

// Icon draws a Phosphor Light icon in the current text colour (see iconPaths).
// Unknown names draw nothing.
templ Icon(name string) {
	if paths, ok := iconPaths[name]; ok {
		<svg class="icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
			for _, d := range paths {
				<path d={ d }></path>
			}
		</svg>
	}
}
